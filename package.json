{
  "name": "modula-runner-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "modula-runner": "packages/runner/dist/bin/modula-runner.js"
  },
  "workspaces": [
    "packages/linux-file-lock",
    "packages/protocol",
    "packages/runner"
  ],
  "engines": {
    "node": "22.22.3"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "packageManager": "npm@10.9.8",
  "volta": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "scripts": {
    "build": "npm run build -w packages/protocol && npm run build -w packages/runner",
    "typecheck": "npm run build && npm run typecheck -w packages/runner",
    "test": "npm run build && vitest run",
    "gate": "npm run typecheck && vitest run",
    "blackbox": "vitest run -c packages/runner/test/blackbox/vitest.config.ts",
    "blackbox:manual": "node scripts/blackbox-manual.mjs",
    "release:build": "node scripts/release.mjs build",
    "release:reproducible": "node scripts/release.mjs reproducible",
    "supply-chain:audit": "node scripts/supply-chain.mjs live-audit",
    "supply-chain:gate": "node scripts/supply-chain.mjs gate",
    "supply-chain:seeded-red": "node scripts/supply-chain.mjs seed-known-vulnerability"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "semver": "7.7.4",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
